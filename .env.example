# PawFinder Environment Configuration

# Supabase PostgreSQL & Storage Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Gemini Vision & AI Assistant Key (Keep secret on server/edge function)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# Razorpay India Payment Configuration (Key ID only in client)
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere

# Google Maps / Places API Key
GOOGLE_MAPS_API_KEY=AIzaSyYourGoogleMapsApiKeyHere

# Python ML NGO Classification Endpoint
ML_NGO_ENDPOINT=http://localhost:8000/classify-ngo
