# ============================================================================
# PashuRakhshak (पशुरक्षक) - Environment Variables Example File (.env.example)
# Copy this file to .env and fill in your real API keys before running
# ============================================================================

# 1. Supabase Backend API & Database Configuration
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 2. Google Maps & Google Places API Key
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
VITE_GOOGLE_PLACES_API_KEY=your-google-places-api-key-here
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# 3. Gemini Vision AI API Key
VITE_GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# 4. Razorpay India Payment Gateway Key ID
VITE_RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere

# 5. ML NGO Classification Endpoint
ML_NGO_ENDPOINT=http://localhost:8000/classify-ngo
